{
  "name": "bhouston-link-checker",
  "version": "0.1.0",
  "private": false,
  "description": "A Playwright-powered CLI for crawling pages and checking links.",
  "bin": {
    "bhouston-link-checker": "./dist/bin/bhouston-link-checker.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "prepare": "husky",
    "build": "tsgo --project tsconfig.build.json",
    "start": "node ./dist/bin/bhouston-link-checker.js",
    "make-release": "node scripts/make-release.ts .",
    "tsc": "tsgo --noEmit",
    "pretest": "pnpm build",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "oxfmt .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "clean": "rimraf dist coverage"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "p-limit": "^7.3.0",
    "playwright": "^1.61.1",
    "yargs": "^18.0.0",
    "yargs-file-commands": "^1.2.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@types/yargs": "^17.0.35",
    "@typescript/native-preview": "7.0.0-dev.20260705.1",
    "husky": "^9.1.7",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.72.0",
    "rimraf": "^6.1.3",
    "vitest": "^4.1.9",
    "vitest-command-line": "^0.8.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@11.0.8"
}
