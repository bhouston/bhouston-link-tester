{
  "name": "bhouston-link-checker",
  "version": "1.0.0",
  "private": false,
  "description": "A CLI for crawling pages and checking links.",
  "bin": {
    "bhouston-link-checker": "./dist/bin/bhouston-link-checker.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "prepare": "husky",
    "build": "tsc --project tsconfig.build.json",
    "start": "node ./dist/bin/bhouston-link-checker.js",
    "tsc": "tsc --noEmit",
    "pretest": "pnpm build",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "oxfmt .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "clean": "rimraf dist coverage",
    "commitlint": "commitlint",
    "release": "semantic-release",
    "release:check": "node scripts/check-release.mjs"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "playwright": "^1.61.1",
    "yargs": "^18.0.0",
    "yargs-file-commands": "^1.2.2"
  },
  "devDependencies": {
    "@anolilab/semantic-release-pnpm": "^8.1.25",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@semantic-release/changelog": "^7.0.0",
    "@types/node": "^26.1.0",
    "@types/yargs": "^17.0.35",
    "@vitest/coverage-v8": "^4.1.11",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "rimraf": "^6.1.3",
    "semantic-release": "^25.0.9",
    "typescript": "^7",
    "vitest": "^4.1.11",
    "vitest-command-line": "^0.8.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "oxfmt",
      "oxlint --fix"
    ],
    "*.{json,jsonc,md,mdx,css,html,yml,yaml}": "oxfmt"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.27.0"
}
