{
  "name": "bhouston-link-checker",
  "version": "1.0.0",
  "private": false,
  "description": "A CLI for crawling pages and checking links.",
  "bin": {
    "bhouston-link-checker": "./dist/bin/bhouston-link-checker.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "prepare": "husky",
    "build": "tsc --project tsconfig.build.json",
    "start": "node ./dist/bin/bhouston-link-checker.js",
    "make-release": "node scripts/make-release.ts .",
    "tsc": "tsc --noEmit",
    "pretest": "pnpm build",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "oxfmt .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "clean": "rimraf dist coverage"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "playwright": "^1.61.1",
    "yargs": "^18.0.0",
    "yargs-file-commands": "^1.2.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@types/yargs": "^17.0.35",
    "husky": "^9.1.7",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "rimraf": "^6.1.3",
    "typescript": "^7",
    "vitest": "^4.1.10",
    "vitest-command-line": "^0.8.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@11.0.8"
}
