{
  "name": "bhouston-link-checker",
  "version": "1.0.0",
  "private": false,
  "description": "A CLI for crawling pages and checking links.",
  "bin": {
    "bhouston-link-checker": "./dist/bin/bhouston-link-checker.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "prepare": "husky",
    "build": "tsc --project tsconfig.build.json",
    "start": "node ./dist/bin/bhouston-link-checker.js",
    "tsc": "tsc --noEmit",
    "pretest": "pnpm build",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "oxfmt .",
    "lint": "oxlint --type-aware --type-check .",
    "lint:fix": "oxlint --type-aware --type-check --fix .",
    "clean": "rimraf dist coverage",
    "docgen": "node ./dist/bin/bhouston-link-checker.js docgen --output opencli.json",
    "commitlint": "commitlint",
    "release": "semantic-release",
    "release:check": "node scripts/check-release.mjs"
  },
  "dependencies": {
    "@clidoc/core": "^1.1.1",
    "@clidoc/yargs": "^1.1.1",
    "chalk": "^5.6.2",
    "playwright": "^1.64.1",
    "yargs": "^18.2.0",
    "yargs-file-commands": "^2.1.0"
  },
  "devDependencies": {
    "@anolilab/semantic-release-pnpm": "^8.1.36",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^26.6.6",
    "@types/yargs": "^17.0.35",
    "@vitest/coverage-v8": "^5.0.5",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "rimraf": "^6.1.3",
    "semantic-release": "^25.0.9",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "vitest-command-line": "^0.9.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "oxfmt",
      "oxlint --fix"
    ],
    "*.{json,jsonc,md,mdx,css,html,yml,yaml}": "oxfmt"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.16.1"
}
